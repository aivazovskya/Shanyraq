{
  "expo": {
    "name": "Shanyraq",
    "slug": "shanyraq-resident",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#059669",
      "dark": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#0F172A"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.shanyraq.app",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "package": "kz.shanyraq.app",
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Разрешите Shanyraq использовать камеру для прикрепления фото.",
          "photosPermission": "Разрешите Shanyraq выбирать фото для прикрепления.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
