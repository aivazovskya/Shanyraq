{
  "expo": {
    "name": "Shanyraq",
    "slug": "shanyraq-resident",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "kz.shanyraq.resident"
    },
    "android": {
      "package": "kz.shanyraq.resident"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Разрешите Shanyraq использовать камеру для прикрепления фото.",
          "photosPermission": "Разрешите Shanyraq выбирать фото для прикрепления.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
