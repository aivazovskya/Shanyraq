    "test:screen-data": "node --test tests/decimal-input.test.cjs tests/voting-response.test.cjs",
    "test:hold": "node --test tests/hold-confirmation.test.cjs",
    "test:phone": "node --test tests/phone-input.test.cjs",
    "preview:ui": "expo start ./preview --web --port 8182",
