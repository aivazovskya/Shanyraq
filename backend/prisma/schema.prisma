generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  HOA_ADMIN
  HOA_CHAIRMAN
  DISPATCHER
  SECURITY
  RESIDENT_OWNER
  RESIDENT_TENANT
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  PARKING
  STORAGE
}

enum OwnershipType {
  OWNER
  TENANT
  FAMILY_MEMBER
}

enum RequestCategory {
  PLUMBING
  ELECTRICAL
  ELEVATOR
  HEATING
  YARD_TERRITORY
  INTERCOM_ACCESS
  CLEANING
  OTHER
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MeetingStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DecisionType {
  SIMPLE_MAJORITY     // >50% голосов от участников кворума
  QUALIFIED_MAJORITY  // 2/3 голосов или >51% от всех собственников ЖК
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum AccessPointType {
  BARRIER
  GATE
  DOOR_INTERCOM
  CAMERA
}

// -------------------------------------------------------------
// Core Living Infrastructure & Tenancy
// -------------------------------------------------------------

model Tenant {
  id               String            @id @default(uuid())
  name             String            // Название ЖК, напр. "ЖК Шаңырақ Премиум"
  address          String
  city             String            @default("Астана")
  totalArea        Float             @default(0) // Суммарная площадь жилых и нежилых помещений (м²)
  totalUnitsCount  Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  buildings        Building[]
  users            User[]
  serviceRequests  ServiceRequest[]
  meetings         Meeting[]
  accessPoints     AccessPoint[]
  announcements    Announcement[]
  tariffItems      TariffItem[]
  bookableResources BookableResource[]
  sosAlerts         SosAlert[]
  communityListings CommunityListing[]
  conversations     Conversation[]
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Building {
  id               String            @id @default(uuid())
  tenantId         String
  blockName        String            // "Блок А", "Дом 12"
  floorsCount      Int               @default(9)
  entrancesCount   Int               @default(1)
  totalArea        Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units            Unit[]

  @@map("buildings")
}

model Unit {
  id               String            @id @default(uuid())
  buildingId       String
  unitNumber       String            // Номер квартиры / паркинга "42"
  floor            Int               @default(1)
  entrance         Int               @default(1)
  type             UnitType          @default(APARTMENT)
  area             Float             // Площадь (м²), ключевой параметр для веса голоса в ОСС
  cadastralNumber  String?           // Кадастровый номер
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  building         Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  ownerships       UnitOwnership[]
  serviceRequests  ServiceRequest[]
  votes            Vote[]
  guestPasses      GuestPass[]
  accessLogs       AccessLog[]
  personalAccount  PersonalAccount?
  meters           Meter[]
  bookings         Booking[]
  sosAlerts        SosAlert[]

  @@unique([buildingId, unitNumber])
  @@map("units")
}

// -------------------------------------------------------------
// Users, Identity & Ownership
// -------------------------------------------------------------

model User {
  id               String            @id @default(uuid())
  phone            String            @unique // Номер телефона для SMS-входа: +77011234567
  email            String?           @unique
  passwordHash     String?
  firstName        String
  lastName         String
  iin              String?           // ИИН жителя для юридической идентификации в РК
  role             UserRole          @default(RESIDENT_OWNER)
  tenantId         String?
  isActive         Boolean           @default(true)
  isVerified       Boolean           @default(false)
  tokenVersion     Int               @default(1)
  accessPinHash    String?           // bcrypt hash of 4-6 digit access PIN
  accessPinSetAt   DateTime?
  mustChangePassword Boolean         @default(false)
  notificationPreferences Json?
  hidePhoneInListings  Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  ownerships       UnitOwnership[]
  createdRequests  ServiceRequest[]  @relation("CreatedRequests")
  assignedRequests ServiceRequest[]  @relation("AssignedRequests")
  requestComments  RequestComment[]
  votes            Vote[]
  accessLogs       AccessLog[]
  createdPasses    GuestPass[]       @relation("CreatedGuestPasses")
  revokedPasses    GuestPass[]       @relation("RevokedGuestPasses")
  deviceTokens      DeviceToken[]
  notifications     Notification[]
  recordedPayments  Payment[]
  submittedReadings MeterReading[]   @relation("SubmittedReadings")
  reviewedReadings  MeterReading[]   @relation("ReviewedReadings")
  bookingsMade      Booking[]        @relation("BookingsMade")
  bookingsCancelled Booking[]        @relation("BookingsCancelled")
  sosAlertsTriggered SosAlert[]      @relation("SosTriggered")
  sosAlertsResolved  SosAlert[]      @relation("SosResolved")
  listingsAuthored   CommunityListing[] @relation("ListingsAuthored")
  listingsRemoved    CommunityListing[] @relation("ListingsRemoved")
  announcementsAuthored Announcement[]  @relation("AnnouncementsAuthored")
  announcementsRemoved  Announcement[]  @relation("AnnouncementsRemoved")
  conversationsAsResident Conversation[] @relation("ConversationsAsResident")
  chatMessagesSent        ChatMessage[]  @relation("ChatMessagesSent")
  auditLogs               AuditLog[]

  @@map("users")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   // "ios" | "android" | "expo"
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_tokens")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model UnitOwnership {
  id               String            @id @default(uuid())
  userId           String
  unitId           String
  ownershipType    OwnershipType     @default(OWNER)
  sharePercent     Float             @default(100.0) // Доля в квартире (если несколько собственников)
  isVerified       Boolean           @default(false)
  verificationDoc  String?           // Ссылка на скан выписки eGov или ДДУ
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("unit_ownerships")
}

// -------------------------------------------------------------
// Service Desk (Заявки и обслуживание)
// -------------------------------------------------------------

model ServiceRequest {
  id               String            @id @default(uuid())
  tenantId         String
  unitId           String
  creatorId        String
  assigneeId       String?
  title            String
  description      String
  category         RequestCategory   @default(OTHER)
  status           RequestStatus     @default(PENDING)
  priority         RequestPriority   @default(MEDIUM)
  rating           Int?              // Оценка от 1 до 5
  feedback         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creator          User              @relation("CreatedRequests", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee         User?             @relation("AssignedRequests", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments         RequestComment[]
  attachments      RequestAttachment[]

  @@map("service_requests")
}

model RequestComment {
  id               String            @id @default(uuid())
  requestId        String
  authorId         String
  text             String
  isInternal       Boolean           @default(false) // Внутренний комментарий для диспетчеров
  createdAt        DateTime          @default(now())

  request          ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("request_comments")
}

model RequestAttachment {
  id               String            @id @default(uuid())
  requestId        String
  fileUrl          String
  fileType         String            @default("image/jpeg")
  createdAt        DateTime          @default(now())

  request          ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_attachments")
}

// -------------------------------------------------------------
// Meetings & Voting (Общие собрания собственников - ОСС)
// -------------------------------------------------------------

model Meeting {
  id                      String         @id @default(uuid())
  tenantId                String
  title                   String         // Тема собрания, напр. "Годовой отчет ОСИ и выбор тарифа на 2026 год"
  description             String?
  startDate               DateTime
  endDate                 DateTime
  status                  MeetingStatus  @default(DRAFT)
  totalEligibleArea       Float          @default(0) // Суммарная площадь дома на момент открытия голосования
  quorumThresholdPercent  Float          @default(50.0) // По закону РК >50%
  calculatedQuorumPercent Float          @default(0)
  isQuorumAchieved        Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  tenant                  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendaItems             AgendaItem[]
  protocol                MeetingProtocol?

  @@map("meetings")
}

model AgendaItem {
  id               String            @id @default(uuid())
  meetingId        String
  orderIndex       Int               @default(1)
  question         String            // Вопрос повестки дня
  description      String?
  decisionType     DecisionType      @default(SIMPLE_MAJORITY)
  documentUrls     String[]          @default([])
  createdAt        DateTime          @default(now())

  meeting          Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes            Vote[]

  @@map("agenda_items")
}

model Vote {
  id               String            @id @default(uuid())
  agendaItemId     String
  userId           String
  unitId           String
  choice           VoteChoice
  areaWeight       Float             // Вес голоса = полезная площадь квартиры * (доля владения / 100)
  voteHash         String            // SHA-256 криптографический слепок волеизъявления
  otpVerified      Boolean           @default(true)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime          @default(now())

  agendaItem       AgendaItem        @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([agendaItemId, unitId]) // Одна квартира/доля голосует по вопросу один раз
  @@map("votes")
}

model MeetingProtocol {
  id               String            @id @default(uuid())
  meetingId        String            @unique
  protocolNumber   String            // Номер протокола ОСС-2026/01
  pdfUrl           String?
  isSigned         Boolean           @default(false)
  generatedAt      DateTime          @default(now())

  meeting          Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_protocols")
}

// -------------------------------------------------------------
// Access Control & Video (СКУД, Шлагбаумы, Камеры)
// -------------------------------------------------------------

model AccessPoint {
  id               String            @id @default(uuid())
  tenantId         String
  name             String            // "Главный шлагбаум (Въезд)", "Камера двора"
  type             AccessPointType   @default(BARRIER)
  controllerType   String            @default("PAL_ES") // PAL_ES, MQTT_RELAY, RTSP_CAMERA
  endpointUrl      String?           // URL API контроллера
  rtspStreamUrl    String?           // RTSP поток для go2rtc (конфиденциально, скрыто от жителей)
  streamName       String?           // Имя потока в go2rtc (например, courtyard_cam_1)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs             AccessLog[]

  @@map("access_points")
}

model AccessLog {
  id               String            @id @default(uuid())
  accessPointId    String
  userId           String?
  unitId           String?
  action           String            // "OPEN_BARRIER", "VIEW_CAMERA", "GUEST_CODE_ENTRY"
  status           String            @default("SUCCESS") // "SUCCESS", "DENIED"
  note             String?
  createdAt        DateTime          @default(now())

  accessPoint      AccessPoint       @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit             Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@map("access_logs")
}

model GuestPass {
  id               String            @id @default(uuid())
  unitId           String
  creatorId        String
  guestName        String?
  guestPlateNumber String?           // Номер авто гостя, напр. "012KZ01"
  accessCode       String            // Одноразовый 6-значный PIN или UUID для QR-кода
  qrCodeUrl        String?           // Ссылка на QR-код пропуска
  validFrom        DateTime
  validTo          DateTime
  isUsed           Boolean           @default(false)
  isRevoked        Boolean           @default(false)
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime          @default(now())

  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creator          User              @relation("CreatedGuestPasses", fields: [creatorId], references: [id], onDelete: Cascade)
  revokedBy        User?             @relation("RevokedGuestPasses", fields: [revokedById], references: [id], onDelete: SetNull)

  @@map("guest_passes")
}

// -------------------------------------------------------------
// Announcements & News (Лента новостей и оповещений)
// -------------------------------------------------------------

enum AnnouncementStatus {
  ACTIVE
  REMOVED
}

model Announcement {
  id               String             @id @default(uuid())
  tenantId         String
  authorId         String
  title            String
  content          String
  isUrgent         Boolean            @default(false) // Срочное (аварии, отключения)
  status           AnnouncementStatus @default(ACTIVE)
  removedById      String?
  removedReason    String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author           User               @relation("AnnouncementsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy        User?              @relation("AnnouncementsRemoved", fields: [removedById], references: [id], onDelete: SetNull)

  @@map("announcements")
}

// -------------------------------------------------------------
// Finance & Personal Accounts (Лицевые счета и начисления)
// -------------------------------------------------------------

enum ChargeCalculationMethod {
  FLAT              // fixed amount per unit, regardless of area
  PER_AREA          // rate × unit.area
  PER_CONSUMPTION   // rate × metered usage (consumption)
}

enum MeterType {
  COLD_WATER
  HOT_WATER
  ELECTRICITY
  OTHER
}

enum ReadingStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentMethod {
  MANUAL     // recorded by staff — cash, bank transfer, anything off-platform
}

model TariffItem {
  id                String                   @id @default(uuid())
  tenantId          String
  name              String                   // "Коммунальные услуги", "Домофон", "Лифт", etc. — fully staff-defined
  calculationMethod ChargeCalculationMethod  @default(FLAT)
  meterType         MeterType?               // required when calculationMethod = PER_CONSUMPTION
  rate              Float                    // flat amount, or per-m² rate depending on calculationMethod
  isActive          Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  tenant            Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charges           Charge[]

  @@map("tariff_items")
}

model PersonalAccount {
  id             String    @id @default(uuid())
  unitId         String    @unique
  accountNumber  String    @unique   // human-readable, e.g. derived from building+unit — generate on create
  balance        Float     @default(0)  // positive = credit, negative = debt; always recomputed, never trust a manual write
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  unit           Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  charges        Charge[]
  payments       Payment[]

  @@map("personal_accounts")
}

model Charge {
  id            String    @id @default(uuid())
  accountId     String
  tariffItemId  String
  periodMonth   Int       // 1-12
  periodYear    Int
  amount        Float
  createdAt     DateTime  @default(now())

  account       PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tariffItem    TariffItem      @relation(fields: [tariffItemId], references: [id], onDelete: Restrict)

  @@unique([accountId, tariffItemId, periodMonth, periodYear])
  @@map("charges")
}

model Payment {
  id             String        @id @default(uuid())
  accountId      String
  amount         Float
  method         PaymentMethod @default(MANUAL)
  recordedById   String        // staff member who recorded it — always required, no unattended payment source exists
  note           String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  account        PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordedBy     User            @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@map("payments")
}

// -------------------------------------------------------------
// Meter Readings (Счетчики и показания)
// -------------------------------------------------------------

model Meter {
  id           String         @id @default(uuid())
  unitId       String
  type         MeterType
  serialNumber String?
  initialValue Float          @default(0) // baseline for the first reading's consumption calc
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())

  unit         Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  readings     MeterReading[]

  @@map("meters")
}

model MeterReading {
  id            String        @id @default(uuid())
  meterId       String
  submittedById String
  value         Float         // cumulative reading, not a delta
  photoUrl      String        // required — ТЗ calls for photo confirmation
  periodMonth   Int
  periodYear    Int
  status        ReadingStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  createdAt     DateTime      @default(now())

  meter         Meter         @relation(fields: [meterId], references: [id], onDelete: Cascade)
  submittedBy   User          @relation("SubmittedReadings", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy    User?         @relation("ReviewedReadings", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([meterId, periodMonth, periodYear])
  @@map("meter_readings")
}

// -------------------------------------------------------------
// Bookable Resources & Amenity Bookings (Общие пространства)
// -------------------------------------------------------------

enum BookableResourceType {
  GUEST_PARKING
  COWORKING
  BBQ_AREA
  KIDS_ROOM
  OTHER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model BookableResource {
  id                  String               @id @default(uuid())
  tenantId            String
  name                String               // "Барбекю-зона", "Коворкинг", "Гостевой паркинг №3" — fully staff-defined
  type                BookableResourceType
  description         String?
  operatingHoursStart String?              // "08:00" — simple HH:mm string
  operatingHoursEnd   String?              // "22:00"
  maxDurationMinutes  Int?                 // optional cap per booking; null = no cap
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@map("bookable_resources")
}

model Booking {
  id            String        @id @default(uuid())
  resourceId    String
  unitId        String
  bookedById    String
  startTime     DateTime
  endTime       DateTime
  status        BookingStatus @default(CONFIRMED)
  note          String?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())

  resource    BookableResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  unit        Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  bookedBy    User             @relation("BookingsMade", fields: [bookedById], references: [id], onDelete: Cascade)
  cancelledBy User?            @relation("BookingsCancelled", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@map("bookings")
}

enum SosAlertStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

model SosAlert {
  id             String         @id @default(uuid())
  tenantId       String
  unitId         String?        // best-effort: the triggering resident's unit if they have one on file, null otherwise — never block on this
  triggeredById  String
  latitude       Float?
  longitude      Float?
  status         SosAlertStatus @default(ACTIVE)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime       @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit        Unit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  triggeredBy User   @relation("SosTriggered", fields: [triggeredById], references: [id], onDelete: Cascade)
  resolvedBy  User?  @relation("SosResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("sos_alerts")
}

// -------------------------------------------------------------
// Community Board (Доска объявлений жильцов)
// -------------------------------------------------------------

enum ListingType {
  SELL
  RENT
  GIVE_AWAY
  OTHER
}

enum ListingStatus {
  ACTIVE
  CLOSED    // author marked resolved (sold / given away / no longer needed)
  REMOVED   // moderator took it down
  ARCHIVED  // system auto-archived after N days of inactivity
}

model CommunityListing {
  id            String        @id @default(uuid())
  tenantId      String
  authorId      String
  type          ListingType
  title         String
  description   String
  price         Float?        // null for GIVE_AWAY or a non-priced OTHER post
  photoUrls     String[]      @default([])
  status        ListingStatus @default(ACTIVE)
  removedById   String?
  removedReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author    User   @relation("ListingsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  removedBy User?  @relation("ListingsRemoved", fields: [removedById], references: [id], onDelete: SetNull)

  @@map("community_listings")
}

// -------------------------------------------------------------
// Dispatcher Chat (Чат с диспетчером УК)
// -------------------------------------------------------------

model Conversation {
  id                   String    @id @default(uuid())
  tenantId             String
  residentId           String
  lastReadByResidentAt DateTime?
  lastReadByStaffAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resident User          @relation("ConversationsAsResident", fields: [residentId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([tenantId, residentId])
  @@map("conversations")
}

model ChatMessage {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  text           String?
  photoUrl       String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ChatMessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  actorId    String?
  action     String   // TARIFF_CREATED | TARIFF_UPDATED | RESIDENT_ACTIVATED | RESIDENT_DEACTIVATED | LISTING_MODERATED | OWNERSHIP_VERIFIED | OWNERSHIP_REJECTED
  targetType String   // TariffItem | User | CommunityListing | UnitOwnership
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

