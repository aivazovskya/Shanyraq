generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  HOA_ADMIN
  HOA_CHAIRMAN
  DISPATCHER
  SECURITY
  RESIDENT_OWNER
  RESIDENT_TENANT
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  PARKING
  STORAGE
}

enum OwnershipType {
  OWNER
  TENANT
  FAMILY_MEMBER
}

enum RequestCategory {
  PLUMBING
  ELECTRICAL
  ELEVATOR
  HEATING
  YARD_TERRITORY
  INTERCOM_ACCESS
  CLEANING
  OTHER
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum MeetingStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DecisionType {
  SIMPLE_MAJORITY     // >50% голосов от участников кворума
  QUALIFIED_MAJORITY  // 2/3 голосов или >51% от всех собственников ЖК
}

enum VoteChoice {
  FOR
  AGAINST
  ABSTAIN
}

enum AccessPointType {
  BARRIER
  GATE
  DOOR_INTERCOM
  CAMERA
}

// -------------------------------------------------------------
// Core Living Infrastructure & Tenancy
// -------------------------------------------------------------

model Tenant {
  id               String            @id @default(uuid())
  name             String            // Название ЖК, напр. "ЖК Шаңырақ Премиум"
  address          String
  city             String            @default("Астана")
  totalArea        Float             @default(0) // Суммарная площадь жилых и нежилых помещений (м²)
  totalUnitsCount  Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  buildings        Building[]
  users            User[]
  serviceRequests  ServiceRequest[]
  meetings         Meeting[]
  accessPoints     AccessPoint[]
  announcements    Announcement[]

  @@map("tenants")
}

model Building {
  id               String            @id @default(uuid())
  tenantId         String
  blockName        String            // "Блок А", "Дом 12"
  floorsCount      Int               @default(9)
  entrancesCount   Int               @default(1)
  totalArea        Float             @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units            Unit[]

  @@map("buildings")
}

model Unit {
  id               String            @id @default(uuid())
  buildingId       String
  unitNumber       String            // Номер квартиры / паркинга "42"
  floor            Int               @default(1)
  entrance         Int               @default(1)
  type             UnitType          @default(APARTMENT)
  area             Float             // Площадь (м²), ключевой параметр для веса голоса в ОСС
  cadastralNumber  String?           // Кадастровый номер
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  building         Building          @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  ownerships       UnitOwnership[]
  serviceRequests  ServiceRequest[]
  votes            Vote[]
  guestPasses      GuestPass[]
  accessLogs       AccessLog[]

  @@unique([buildingId, unitNumber])
  @@map("units")
}

// -------------------------------------------------------------
// Users, Identity & Ownership
// -------------------------------------------------------------

model User {
  id               String            @id @default(uuid())
  phone            String            @unique // Номер телефона для SMS-входа: +77011234567
  email            String?           @unique
  passwordHash     String?
  firstName        String
  lastName         String
  iin              String?           // ИИН жителя для юридической идентификации в РК
  role             UserRole          @default(RESIDENT_OWNER)
  tenantId         String?
  isActive         Boolean           @default(true)
  isVerified       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  ownerships       UnitOwnership[]
  createdRequests  ServiceRequest[]  @relation("CreatedRequests")
  assignedRequests ServiceRequest[]  @relation("AssignedRequests")
  requestComments  RequestComment[]
  votes            Vote[]
  accessLogs       AccessLog[]
  createdPasses    GuestPass[]
  announcements    Announcement[]

  @@map("users")
}

model UnitOwnership {
  id               String            @id @default(uuid())
  userId           String
  unitId           String
  ownershipType    OwnershipType     @default(OWNER)
  sharePercent     Float             @default(100.0) // Доля в квартире (если несколько собственников)
  isVerified       Boolean           @default(false)
  verificationDoc  String?           // Ссылка на скан выписки eGov или ДДУ
  verifiedAt       DateTime?
  createdAt        DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@map("unit_ownerships")
}

// -------------------------------------------------------------
// Service Desk (Заявки и обслуживание)
// -------------------------------------------------------------

model ServiceRequest {
  id               String            @id @default(uuid())
  tenantId         String
  unitId           String
  creatorId        String
  assigneeId       String?
  title            String
  description      String
  category         RequestCategory   @default(OTHER)
  status           RequestStatus     @default(PENDING)
  priority         RequestPriority   @default(MEDIUM)
  rating           Int?              // Оценка от 1 до 5
  feedback         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creator          User              @relation("CreatedRequests", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee         User?             @relation("AssignedRequests", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments         RequestComment[]
  attachments      RequestAttachment[]

  @@map("service_requests")
}

model RequestComment {
  id               String            @id @default(uuid())
  requestId        String
  authorId         String
  text             String
  isInternal       Boolean           @default(false) // Внутренний комментарий для диспетчеров
  createdAt        DateTime          @default(now())

  request          ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("request_comments")
}

model RequestAttachment {
  id               String            @id @default(uuid())
  requestId        String
  fileUrl          String
  fileType         String            @default("image/jpeg")
  createdAt        DateTime          @default(now())

  request          ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("request_attachments")
}

// -------------------------------------------------------------
// Meetings & Voting (Общие собрания собственников - ОСС)
// -------------------------------------------------------------

model Meeting {
  id                      String         @id @default(uuid())
  tenantId                String
  title                   String         // Тема собрания, напр. "Годовой отчет ОСИ и выбор тарифа на 2026 год"
  description             String?
  startDate               DateTime
  endDate                 DateTime
  status                  MeetingStatus  @default(DRAFT)
  totalEligibleArea       Float          @default(0) // Суммарная площадь дома на момент открытия голосования
  quorumThresholdPercent  Float          @default(50.0) // По закону РК >50%
  calculatedQuorumPercent Float          @default(0)
  isQuorumAchieved        Boolean        @default(false)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  tenant                  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agendaItems             AgendaItem[]
  protocol                MeetingProtocol?

  @@map("meetings")
}

model AgendaItem {
  id               String            @id @default(uuid())
  meetingId        String
  orderIndex       Int               @default(1)
  question         String            // Вопрос повестки дня
  description      String?
  decisionType     DecisionType      @default(SIMPLE_MAJORITY)
  documentUrls     String[]          @default([])
  createdAt        DateTime          @default(now())

  meeting          Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes            Vote[]

  @@map("agenda_items")
}

model Vote {
  id               String            @id @default(uuid())
  agendaItemId     String
  userId           String
  unitId           String
  choice           VoteChoice
  areaWeight       Float             // Вес голоса = полезная площадь квартиры * (доля владения / 100)
  voteHash         String            // SHA-256 криптографический слепок волеизъявления
  otpVerified      Boolean           @default(true)
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime          @default(now())

  agendaItem       AgendaItem        @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([agendaItemId, unitId]) // Одна квартира/доля голосует по вопросу один раз
  @@map("votes")
}

model MeetingProtocol {
  id               String            @id @default(uuid())
  meetingId        String            @unique
  protocolNumber   String            // Номер протокола ОСС-2026/01
  pdfUrl           String?
  isSigned         Boolean           @default(false)
  generatedAt      DateTime          @default(now())

  meeting          Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_protocols")
}

// -------------------------------------------------------------
// Access Control & Video (СКУД, Шлагбаумы, Камеры)
// -------------------------------------------------------------

model AccessPoint {
  id               String            @id @default(uuid())
  tenantId         String
  name             String            // "Главный шлагбаум (Въезд)", "Камера двора"
  type             AccessPointType   @default(BARRIER)
  controllerType   String            @default("PAL_ES") // PAL_ES, MQTT_RELAY, RTSP_CAMERA
  endpointUrl      String?           // URL API контроллера
  rtspStreamUrl    String?           // RTSP поток для go2rtc (конфиденциально, скрыто от жителей)
  streamName       String?           // Имя потока в go2rtc (например, courtyard_cam_1)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs             AccessLog[]

  @@map("access_points")
}

model AccessLog {
  id               String            @id @default(uuid())
  accessPointId    String
  userId           String?
  unitId           String?
  action           String            // "OPEN_BARRIER", "VIEW_CAMERA", "GUEST_CODE_ENTRY"
  status           String            @default("SUCCESS") // "SUCCESS", "DENIED"
  note             String?
  createdAt        DateTime          @default(now())

  accessPoint      AccessPoint       @relation(fields: [accessPointId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit             Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@map("access_logs")
}

model GuestPass {
  id               String            @id @default(uuid())
  unitId           String
  creatorId        String
  guestName        String?
  guestPlateNumber String?           // Номер авто гостя, напр. "012KZ01"
  accessCode       String            // Одноразовый 6-значный PIN или UUID для QR-кода
  qrCodeUrl        String?           // Ссылка на QR-код пропуска
  validFrom        DateTime
  validTo          DateTime
  isUsed           Boolean           @default(false)
  createdAt        DateTime          @default(now())

  unit             Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  creator          User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("guest_passes")
}

// -------------------------------------------------------------
// Announcements & News (Лента новостей и оповещений)
// -------------------------------------------------------------

model Announcement {
  id               String            @id @default(uuid())
  tenantId         String
  authorId         String
  title            String
  content          String
  isUrgent         Boolean           @default(false) // Срочное (аварии, отключения)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}
