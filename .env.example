# ==============================================
# Shanyraq Platform Configuration (.env)
# ==============================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Reverse Proxy Trust (число хопов перед Express: строго неотрицательное целое число, 0 в dev, 1 в prod за reverse proxy)
# Значения 'true' и нечисловые запрещены и вызовут ошибку при старте приложения
TRUST_PROXY=0

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://shanyraq_admin:shanyraq_secure_password_2026@localhost:5432/shanyraq_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT & Cryptographic Signing Keys (Обязательно сгенерировать уникальные ключи на проде!)
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_generate_with_openssl_rand_hex_32"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_generate_with_openssl_rand_hex_32"
VOTE_SIGNING_KEY="CHANGE_ME_IN_PRODUCTION_hmac_sha256_key_for_legal_votes"
# PII Encryption & Lookup Keys (Защита ПДн / ИИН at-rest: AES-256-GCM и HMAC-SHA256)
# Сгенерировать каждый: openssl rand -base64 32
PII_ENCRYPTION_KEY="CHANGE_ME_IN_PRODUCTION_32_byte_base64_key"
PII_HASH_KEY="CHANGE_ME_IN_PRODUCTION_32_byte_base64_key"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# S3 / MinIO Object Storage
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
# Optional client-reachable media origin; never use localhost for a physical phone.
# This does not change bucket permissions. Configure authorized media delivery separately.
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY="CHANGE_ME_IN_PRODUCTION"
S3_SECRET_KEY="CHANGE_ME_IN_PRODUCTION"
S3_BUCKET_DOCS="shanyraq-documents"
S3_BUCKET_MEDIA="shanyraq-media"

# SMS Gateway (Kazakhstan: KazInfoTech / SMS-C / Mobizon / Test Mock)
# Transport is not implemented yet: OTP requests return 503 outside NODE_ENV=test.
# Setting a provider/key alone does not enable delivery. Never use NODE_ENV=test on a server.
SMS_PROVIDER=mock
SMS_API_KEY=mock_api_key
SMS_SENDER_NAME=SHANYRAQ

# Video Streaming (go2rtc)
GO2RTC_API_URL=http://localhost:1984

# Hikvision DS-KV ISAPI integration (optional, needed only if a HIKVISION_ISAPI access point is configured)
# Only HIKVISION_ISAPI can open real devices. MOCK is allowed only in development/test.
# PAL_ES, MQTT_RELAY and unknown controller types fail instead of simulating success.
# Per-device credentials are a future enhancement once there's more than one real installation to justify it.
HIKVISION_DEFAULT_USERNAME=admin
HIKVISION_DEFAULT_PASSWORD=

# ==============================================
# Production Docker Deployment Variables
# ==============================================
POSTGRES_USER=shanyraq_admin
POSTGRES_PASSWORD="CHANGE_ME_IN_PRODUCTION_secure_db_password"
POSTGRES_DB=shanyraq_db
POSTGRES_PORT=5432

REDIS_PASSWORD="CHANGE_ME_IN_PRODUCTION_secure_redis_password"

MINIO_ROOT_USER=shanyraq_minio
MINIO_ROOT_PASSWORD="CHANGE_ME_IN_PRODUCTION_secure_minio_password"
MINIO_CONSOLE_PORT=9001

WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

GO2RTC_API_USER=shanyraq_streamer
GO2RTC_API_PASSWORD="CHANGE_ME_IN_PRODUCTION_secure_go2rtc_password"
