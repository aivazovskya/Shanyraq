# ==============================================
# Shanyraq Platform Configuration (.env)
# ==============================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# Database (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://shanyraq_admin:shanyraq_secure_password_2026@localhost:5432/shanyraq_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT & Cryptographic Signing Keys (Обязательно сгенерировать уникальные ключи на проде!)
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_generate_with_openssl_rand_hex_32"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_generate_with_openssl_rand_hex_32"
VOTE_SIGNING_KEY="CHANGE_ME_IN_PRODUCTION_hmac_sha256_key_for_legal_votes"
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# S3 / MinIO Object Storage
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY="shanyraq_minio"
S3_SECRET_KEY="shanyraq_minio_secret_key"
S3_BUCKET_DOCS="shanyraq-documents"
S3_BUCKET_MEDIA="shanyraq-media"

# SMS Gateway (Kazakhstan: KazInfoTech / SMS-C / Mobizon / Test Mock)
SMS_PROVIDER=mock
SMS_API_KEY=mock_api_key
SMS_SENDER_NAME=SHANYRAQ

# Video Streaming (go2rtc)
GO2RTC_API_URL=http://localhost:1984
